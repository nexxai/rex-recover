#!/bin/sh
# Keep this supervisor outside Rex: the Lua worker loses its connection when
# Rex stops, but this process must stay alive to reconnect after Rex returns.
# Continuing with missing settings could target the wrong state directory.
# State must also stay private because command arguments can contain secrets.
set -eu
umask 077

# Installed copies must work independently of the checkout and launch folder.
# A user's CDPATH can make cd print extra text, corrupting this captured path.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
rex_bin=${REX_BIN:-}
state_dir=${REX_RECOVER_STATE_DIR:-${XDG_STATE_HOME:-"$HOME/.local/state"}/rex-recover}
server=
config=${REX_RECOVER_CONFIG:-${XDG_CONFIG_HOME:-"$HOME/.config"}/rex-recover/apps.conf}
interval=2

# Interactive shells can use environment defaults, while a service needs to
# pin its own paths without depending on the environment it inherited.
usage() {
  echo "Usage: rex-recover [--rex PATH] [--state-dir DIR] [--server unix://PATH] [--config FILE] [--interval SECONDS]"
}

# Paths can contain spaces or shell syntax. Parsing option/value pairs as
# separate arguments avoids accidentally treating their contents as code.
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --rex|--state-dir|--server|--config|--interval)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      case "$1" in
        --rex) rex_bin=$2 ;;
        --state-dir) state_dir=$2 ;;
        --server) server=$2 ;;
        --config) config=$2 ;;
        --interval) interval=$2 ;;
      esac
      shift 2
      ;;
    *) usage >&2; exit 2 ;;
  esac
done

# Recovery checks local process identities and files, so a remote connection
# would not provide the information needed to make a safe recovery decision.
case "$server" in
  ""|unix://*) ;;
  *) echo "Only local Unix-socket servers are supported." >&2; exit 2 ;;
esac

# Silently replacing a bad explicit CLI override could connect through the
# wrong installation. Automatic macOS discovery uses Versions/Current so
# upgrading Rex does not leave the watcher pinned to an obsolete version.
if [ -z "$rex_bin" ]; then
  rex_bin=$(command -v rex 2>/dev/null || :)
  if [ -z "$rex_bin" ] && [ "$(uname -s)" = Darwin ]; then
    bundled="$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"
    if [ -f "$bundled" ] && [ -x "$bundled" ]; then rex_bin=$bundled; fi
  fi
fi
resolved_rex=$(command -v "${rex_bin:-rex}" 2>/dev/null || :)
if [ ! -f "$resolved_rex" ] || [ ! -x "$resolved_rex" ]; then
  echo "Rex CLI not found: ${rex_bin:-rex}. Pass --rex /absolute/path/to/rex or set REX_BIN." >&2
  exit 127
fi
rex_bin=$resolved_rex

# Fail before entering the reconnect loop if the shared app list is invalid.
# Otherwise a configuration typo would produce repeated connection attempts.
if ! "$root/bin/rex-recover-config" "$config" >/dev/null; then exit 2; fi

# Two watchers could race to replay the same command. A kernel-held lock avoids
# both that race and the stale-lock problem of a PID file after a crash.
# Inheriting descriptor 9 keeps a surviving worker protected if its supervisor
# dies; the lock is released when the last holder exits.
mkdir -p -- "$state_dir"
state_dir=$(CDPATH= cd -- "$state_dir" && pwd)
exec 9>"$state_dir/watcher.lock"
if command -v lockf >/dev/null 2>&1; then
  lockf -s -t 0 9 || { echo "Another watcher holds $state_dir" >&2; exit 1; }
elif command -v flock >/dev/null 2>&1; then
  flock -n 9 || { echo "Another watcher holds $state_dir" >&2; exit 1; }
else
  echo "A native file-lock utility (lockf or flock) is required." >&2
  exit 1
fi
child=

# Stopping recovery must not stop the user's work. Only our current child is
# ours to terminate; Rex and its terminal apps are not. Tracking the retry
# delay too avoids making Ctrl-C wait for that delay to finish.
cleanup() {
  if [ -n "$child" ]; then
    kill "$child" 2>/dev/null || :
    wait "$child" 2>/dev/null || :
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Re-evaluating a command string would misinterpret paths containing quotes or
# spaces. Keeping argv separate also lets the worker share the exact parser
# and config used by capture, without a second interpretation of the app list.
# Autostart must stay disabled: a retry is not permission to bring Rex back.
set -- "$rex_bin" --autostart=false
if [ -n "$server" ]; then set -- "$@" --server "$server"; fi
set -- "$@" do "$root/watch.lua" --all --fail-fast \
  "state_path=$state_dir/checkpoint.json" "interval=$interval" \
  "launcher=$root/bin/rex-recover-run" "config=$config" \
  "config_reader=$root/bin/rex-recover-config"

# Connection failure is normal while Rex is down, not a reason to abandon
# recovery. A delay avoids a busy retry loop. Background children let shell
# traps interrupt the wait instead of leaving shutdown stuck behind the CLI.
while :; do
  "$@" &
  child=$!
  wait "$child" || :
  child=
  sleep 1 &
  child=$!
  wait "$child" || :
  child=
done
